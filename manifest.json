{
  "manifest_version": 3,
  "name": "Caelestia-DNT",
  "version": "1.6.0",
  "description": "Dynamic Material You new tab synchronized with Noctalia (Niri) and Caelestia (Hyprland) on Linux",
  "permissions": [
    "windows",
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:39123/*",
    "*://*.youtube.com/*",
    "*://*.github.com/*",
    "*://*.reddit.com/*",
    "*://*.wikipedia.org/*",
    "*://www.google.com/*",
    "*://google.com/*",
    "*://www.google.co.uk/*",
    "*://www.google.ca/*",
    "*://www.google.com.au/*",
    "*://www.google.de/*",
    "*://www.google.fr/*",
    "*://www.google.co.in/*",
    "*://www.google.co.jp/*",
    "*://www.google.com.br/*",
    "*://www.google.com.gh/*",
    "*://web.whatsapp.com/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Caelestia-DNT",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.github.com/*",
        "*://*.reddit.com/*",
        "*://*.wikipedia.org/*",
        "*://www.google.com/*",
        "*://google.com/*",
        "*://www.google.co.uk/*",
        "*://www.google.ca/*",
        "*://www.google.com.au/*",
        "*://www.google.de/*",
        "*://www.google.fr/*",
        "*://www.google.co.in/*",
        "*://www.google.co.jp/*",
        "*://www.google.com.br/*",
        "*://www.google.com.gh/*",
        "*://web.whatsapp.com/*"
      ],
      "js": [
        "sites.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}